# Anty's ticket stand (the project intake). Copy to .env.local and fill in.
# Every variable is optional in development: tickets are saved to a local
# SQLite file and the inbox stays locked until INBOX_PASSWORD is set.

# Where tickets are stored. Default: a SQLite file in .data/ (local dev, or a
# mounted volume on fly.io). For Turso: libsql://<db>-<org>.turso.io plus a token.
INTAKE_DATABASE_URL=file:.data/intake.db
INTAKE_DATABASE_TOKEN=

# Email Nic each new ticket through Resend (https://resend.com). The sender
# must be on a domain verified in Resend; replies go straight to the visitor.
RESEND_API_KEY=
INTAKE_NOTIFY_TO=hello@picnicdev.com
INTAKE_NOTIFY_FROM=Anty at picnicdev <anty@picnicdev.com>

# The private inbox at /inbox. Changing the password signs every session out.
INBOX_PASSWORD=
# Optional extra secret mixed into session signatures.
INBOX_SECRET=
# Optional time zone for inbox dates, e.g. America/New_York.
INBOX_TIMEZONE=

# Public URL, used for the inbox link in notification emails.
SITE_URL=https://picnicdev.com
